#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=normalize
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=slurm_output/norm_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs
export CONDA_PKGS_DIRS=/scratch-shared/lsaleh/.conda/pkgs

export HF_HOME=/scratch-shared/lsaleh/.cache/huggingface
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

source activate thesis

srun python normalize.py \
  --claims_csv outputs/VVDdebate_sample_terrorist_20260401_112625_claims.csv \
  --debates_csv data/debate_sample_terrorist.csv \
  --summaries_csv summaries/debate_sample_terrorist_summary_20260401_112744.csv \
  --output_dir outputs/ \
  --model_name /scratch-shared/lsaleh/models/Qwen2.5-32B-Instruct \
  --add_timestamp