#!/bin/bash
#SBATCH --job-name=conda_env
#SBATCH --output=slurm_output/fix_env_%A.out
#SBATCH --time=01:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

CONDA_BASE=/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1
ENV_PATH=/scratch-shared/lsaleh/.conda/envs/thesis

"$CONDA_BASE/bin/python" -m conda install -y \
  -p "$ENV_PATH" \
  --override-channels \
  -c conda-forge -c pytorch -c nvidia \
  python=3.10

test -d "$ENV_PATH/lib/python3.10/encodings" || {
  echo "ERROR: Python stdlib encodings directory is still missing from $ENV_PATH"
  exit 2
}

"$ENV_PATH/bin/python" -c "import sys, encodings; print(sys.executable); print('python encodings ok')"

"$CONDA_BASE/bin/python" -m conda install -y \
  -p "$ENV_PATH" \
  --override-channels \
  -c pytorch -c nvidia -c conda-forge \
  pytorch=2.4.* pytorch-cuda=12.1 cuda-nvcc=12.1

"$ENV_PATH/bin/python" -c "import torch, transformers; print(torch.__version__); print(torch.cuda.is_available())"
"$ENV_PATH/bin/nvcc" --version
