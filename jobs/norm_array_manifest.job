#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=norm_manifest_batch
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --array=0-10
#SBATCH --output=slurm_output/norm_manifest_batch_%A_%a.out

set -euo pipefail

module load 2025
module load Anaconda3/2025.06-1
source "$(conda info --base)/etc/profile.d/conda.sh"

export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs

export HF_HOME=/scratch-shared/lsaleh/.cache/huggingface
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME"

set +u
conda activate /scratch-shared/lsaleh/.conda/envs/thesis
set -u

python -c "import torch, transformers, sentence_transformers; print(torch.__version__); print(torch.cuda.is_available()); print('ok')"
python -c "from transformers import AutoModelForCausalLM; print('transformers torch backend ok')"

cd ~/thesis

# Array of party names
PARTIES=("50PLUS" "CDA" "CU" "D66" "GL" "PVDA" "PVDD" "PVV" "SGP" "SP" "VVD")

# Get the party for this array task
PARTY=${PARTIES[$SLURM_ARRAY_TASK_ID]}

echo "=========================================="
echo "Task ID: $SLURM_ARRAY_TASK_ID"
echo "Processing Party: $PARTY"
echo "=========================================="

srun python normalize_manifesto.py \
  --manifesto_dir data/manifesto \
  --output_dir outputs/manifesto \
  --party "$PARTY" \
  --model_name /scratch-shared/lsaleh/models/Qwen2.5-32B-Instruct \
  --top_codes 5 \
  --batch_size 8 \
  --checkpoint_every 50 \
  --resume

echo "=========================================="
echo "Task ID: $SLURM_ARRAY_TASK_ID completed"
echo "=========================================="
