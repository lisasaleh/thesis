#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=batch_1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=16:00:00
#SBATCH --output=slurm_output/batch_1_%A.out

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

unset PYTHONHOME
unset PYTHONPATH
CONDA_BASE=/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1
ENV_PATH=/scratch-shared/lsaleh/.conda/envs/thesis
export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs
export HF_HOME=/scratch-shared/lsaleh/.cache/huggingface
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME"
export VLLM_USE_V1=0

source "$CONDA_BASE/etc/profile.d/conda.sh"

test -d "$ENV_PATH/lib/python3.10/encodings" || {
  echo "ERROR: $ENV_PATH is missing lib/python3.10/encodings."
  echo "Run: sbatch jobs/fix_env.job"
  exit 2
}

set +u
conda activate "$ENV_PATH"
set -u
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export CUDA_HOME="$CONDA_PREFIX"
export CUDA_PATH="$CONDA_PREFIX"
export PATH="$CONDA_PREFIX/bin:$PATH"

cd ~/thesis

python -c "import sys, encodings; print(sys.executable); print('python encodings ok')"
python -c "import scipy.optimize, vllm; print('scipy/vllm import ok')"
echo "VLLM_USE_V1=$VLLM_USE_V1"
if command -v nvcc >/dev/null 2>&1; then
  nvcc --version
else
  echo "WARNING: nvcc not found. If vLLM uses FlashInfer JIT, run: sbatch jobs/fix_env.job"
fi
test -f "$CONDA_PREFIX/include/cuda_runtime.h" || {
  echo "ERROR: cuda_runtime.h not found in $CONDA_PREFIX/include."
  echo "Run: sbatch jobs/fix_env.job"
  exit 3
}

MODEL_PATH="Qwen/Qwen2.5-7B-Instruct"
SERVED_MODEL="Qwen/Qwen2.5-7B-Instruct"
API_BASE_URL="http://127.0.0.1:8000/v1"
API_KEY="EMPTY"
PARTY_LIST="VVD"
CMP_RANKS="1"

python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_PATH" \
  --served-model-name "$SERVED_MODEL" \
  --host 127.0.0.1 \
  --port 8000 \
  > slurm_output/vllm_${SLURM_JOB_ID}.log 2>&1 &

VLLM_PID=$!
trap 'kill ${VLLM_PID} 2>/dev/null || true' EXIT

echo "Waiting for vLLM API server..."
for i in $(seq 1 120); do
  if curl -fsS "${API_BASE_URL}/models" >/dev/null 2>&1; then
    echo "vLLM API server is ready"
    break
  fi
  if ! kill -0 "${VLLM_PID}" 2>/dev/null; then
    echo "vLLM server exited before becoming ready"
    tail -100 "slurm_output/vllm_${SLURM_JOB_ID}.log"
    exit 1
  fi
  sleep 5
done

if ! curl -fsS "${API_BASE_URL}/models" >/dev/null 2>&1; then
  echo "Timed out waiting for vLLM API server"
  tail -100 "slurm_output/vllm_${SLURM_JOB_ID}.log"
  exit 1
fi

python orchestrate_pipeline.py \
  --mode sequential \
  --model_7b "$MODEL_PATH" \
  --model_32b /scratch-shared/lsaleh/models/Qwen2.5-32B-Instruct \
  --backend api \
  --api_base_url "$API_BASE_URL" \
  --api_model_name "$SERVED_MODEL" \
  --api_key "$API_KEY" \
  --api_temperature 0 \
  --api_timeout 180 \
  --parties "$PARTY_LIST" \
  --cmp_ranks "$CMP_RANKS" \
  --force \
  --resume
