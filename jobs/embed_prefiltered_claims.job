#!/bin/bash
#SBATCH --partition=rome
#SBATCH --job-name=embed_prefiltered_claims
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00
#SBATCH --output=slurm_output/embed_prefiltered_claims_%A.out

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

unset PYTHONHOME
unset PYTHONPATH
CONDA_BASE=/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1
ENV_PATH=/scratch-shared/lsaleh/.conda/envs/thesis
export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs
export HF_HOME=/scratch-shared/lsaleh/.cache/huggingface
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME"

source "$CONDA_BASE/etc/profile.d/conda.sh"
set +u
conda activate "$ENV_PATH"
set -u

export PATH="$CONDA_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"

cd ~/thesis

PARTIES="${PARTIES:-50PLUS CDA CU D66 GL PVDA PVDD PVV SGP SP VVD}"
INPUT_ROOT="${INPUT_ROOT:-/scratch-shared/lsaleh/prefilter_pipeline}"
BATCH_SIZE="${BATCH_SIZE:-128}"
MODEL_NAME="${MODEL_NAME:-sentence-transformers/all-MiniLM-L6-v2}"

echo "================================================================================"
echo "Embedding prefiltered normalized claims"
echo "================================================================================"
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "PARTIES=$PARTIES"
echo "INPUT_ROOT=$INPUT_ROOT"
echo "BATCH_SIZE=$BATCH_SIZE"
echo "MODEL_NAME=$MODEL_NAME"
echo "================================================================================"

python -m py_compile embed_prefiltered_claims.py

for PARTY in $PARTIES; do
  INPUT_PARTY="$PARTY"
  if [ "$PARTY" = "50PLUS" ]; then
    INPUT_PARTY="SLUS"
  fi

  INPUT_DIR="$INPUT_ROOT/$INPUT_PARTY/normalized"
  OUTPUT_DIR="$INPUT_ROOT/$PARTY/embeddings"

  if [ ! -d "$INPUT_DIR" ]; then
    echo "Missing normalized input directory for party=$PARTY input_party=$INPUT_PARTY: $INPUT_DIR"
    exit 1
  fi

  echo ""
  echo "--------------------------------------------------------------------------------"
  echo "Embedding party=$PARTY input_party=$INPUT_PARTY output_dir=$OUTPUT_DIR"
  echo "--------------------------------------------------------------------------------"

  python embed_prefiltered_claims.py "$PARTY" \
    --input_party "$INPUT_PARTY" \
    --input_root "$INPUT_ROOT" \
    --output_dir "$OUTPUT_DIR" \
    --debates_csv outputs/debates.csv \
    --model_name "$MODEL_NAME" \
    --batch_size "$BATCH_SIZE" \
    --device cpu
done
