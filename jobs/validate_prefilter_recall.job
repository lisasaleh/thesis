#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=validate_prefilter
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=16:00:00
#SBATCH --output=slurm_output/validate_prefilter_%A.out

set -euo pipefail

module purge
module load 2025
module load CUDA/12.8.0
module load Anaconda3/2025.06-1

unset PYTHONHOME
unset PYTHONPATH
CONDA_BASE=/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1
ENV_PATH=/scratch-shared/lsaleh/.conda/envs/thesis
export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs
export HF_HOME=/scratch-shared/lsaleh/.cache/huggingface
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME"
export VLLM_USE_V1=0

source "$CONDA_BASE/etc/profile.d/conda.sh"
set +u
conda activate "$ENV_PATH"
set -u

export CUDA_HOME="${EBROOTCUDA:-${CUDA_HOME:-/sw/arch/RHEL9/EB_production/2025/software/CUDA/12.8.0}}"
export CUDA_PATH="$CUDA_HOME"
export PATH="$CUDA_HOME/bin:$CONDA_PREFIX/bin:$PATH"
export CPATH="$CUDA_HOME/targets/x86_64-linux/include:${CPATH:-}"
export LIBRARY_PATH="$CUDA_HOME/targets/x86_64-linux/lib:${LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="$CUDA_HOME/targets/x86_64-linux/lib:$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"

cd ~/thesis

python -m py_compile extract.py cmp_roberta_prefilter.py batch_party_prefilter.py orchestrate_prefiltered_pipeline.py

MODEL_PATH="Qwen/Qwen2.5-7B-Instruct"
SERVED_MODEL="Qwen/Qwen2.5-7B-Instruct"
API_BASE_URL="http://127.0.0.1:8000/v1"
API_KEY="EMPTY"
VALIDATION_PARTY="${VALIDATION_PARTY:-VVD}"
VALIDATION_CMP_RANKS="${VALIDATION_CMP_RANKS:-1}"

python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_PATH" \
  --served-model-name "$SERVED_MODEL" \
  --host 127.0.0.1 \
  --port 8000 \
  > slurm_output/vllm_${SLURM_JOB_ID}.log 2>&1 &

VLLM_PID=$!
trap 'kill ${VLLM_PID} 2>/dev/null || true' EXIT

echo "Waiting for vLLM API server..."
for i in $(seq 1 120); do
  if curl -fsS "${API_BASE_URL}/models" >/dev/null 2>&1; then
    echo "vLLM API server is ready"
    break
  fi
  sleep 5
done

python orchestrate_prefiltered_pipeline.py \
  --validation_mode \
  --validation_party "$VALIDATION_PARTY" \
  --validation_cmp_ranks "$VALIDATION_CMP_RANKS" \
  --model_7b "$MODEL_PATH" \
  --model_32b /scratch-shared/lsaleh/models/Qwen2.5-32B-Instruct \
  --backend api \
  --api_base_url "$API_BASE_URL" \
  --api_model_name "$SERVED_MODEL" \
  --api_key "$API_KEY" \
  --api_temperature 0 \
  --api_timeout 180 \
  --min_tokens 100 \
  --extract_max_new_tokens 900 \
  --extract_max_claims 15 \
  --prefilter_top_k 3 \
  --resume
