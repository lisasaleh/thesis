#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=mani_norm
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=slurm_output/mani_norm_%A.out

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

unset PYTHONHOME
unset PYTHONPATH
CONDA_BASE=/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1
ENV_PATH=/scratch-shared/lsaleh/.conda/envs/thesis
export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs
export HF_HOME=/scratch-shared/lsaleh/.cache/huggingface
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME"

source "$CONDA_BASE/etc/profile.d/conda.sh"

test -d "$ENV_PATH/lib/python3.10/encodings" || {
  echo "ERROR: $ENV_PATH is missing lib/python3.10/encodings."
  echo "Run: sbatch jobs/fix_env.job"
  exit 2
}

set +u
conda activate "$ENV_PATH"
set -u

cd ~/thesis

python -c "import sys, encodings; print(sys.executable); print('python encodings ok')"
python -c "import torch, transformers; print(torch.__version__); print(torch.cuda.is_available()); print('torch/transformers ok')"

echo "=========================================="
echo "Normalizing manifesto for PvdA"
echo "=========================================="

srun python normalize_manifesto.py \
  --manifesto_dir data/manifesto \
  --output_dir outputs/manifesto \
  --party pvda \
  --model_name /scratch-shared/lsaleh/models/Qwen2.5-32B-Instruct \
  --top_codes 5 \
  --batch_size 8 \
  --checkpoint_every 50 \
  --resume

echo "=========================================="
echo "PvdA manifesto normalization completed"
echo "=========================================="
