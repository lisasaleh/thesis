#!/bin/bash
#SBATCH --job-name=conda_env
#SBATCH --output=slurm_output/fix_env_%A.out
#SBATCH --time=01:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G

set -euo pipefail

module purge
unset PYTHONPATH
unset PYTHONHOME
unset CONDA_PREFIX
unset CONDA_DEFAULT_ENV
unset CONDA_SHLVL

module load 2025
module load Anaconda3/2025.06-1

CONDA_BASE=/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1
source "$CONDA_BASE/etc/profile.d/conda.sh"

export CONDA_ENVS_PATH=/scratch-shared/lsaleh/.conda/envs

conda activate /scratch-shared/lsaleh/.conda/envs/thesis

which python
python -c "import sys; print(sys.executable)"
python -c "import torch; print(torch.__version__)"

conda install -y -c pytorch -c nvidia pytorch=2.4.* pytorch-cuda=12.1

python -c "import torch, transformers; print(torch.__version__); print(torch.cuda.is_available())"